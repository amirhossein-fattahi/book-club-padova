# Copy to .env.local for development. Set production values in Vercel and redeploy.
# Never commit .env.local or put secret keys in NEXT_PUBLIC_ variables.

# Required for durable public registrations. Both blank enables local JSON storage
# only in development; production registrations remain unavailable without a DB.
# SUPABASE_URL: Project Settings > Data API, e.g. https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API Keys > secret/service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the confirmed organizer email in lib/site.ts. This is PUBLIC
# and must be a monitored inbox for replies and privacy/deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional canonical URL for metadata; use the final domain before printing QR codes.
NEXT_PUBLIC_SITE_URL=https://book-club-padova.vercel.app

# Optional organizer alerts via Resend. Both must be set to send alerts.
# Alerts are supplementary; check Supabase regularly even when email is enabled.
RESEND_API_KEY=
NOTIFY_EMAIL=
# With a verified domain, set your sender. Default uses onboarding@resend.dev.
NOTIFY_FROM=

# Optional Cloudflare Turnstile. Set BOTH keys or leave BOTH blank.
# The durable database rate limiter and honeypot also protect public registrations.
# Add the production domain to the Turnstile widget's allowed hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional extra verification: hostname only, with no protocol or path.
TURNSTILE_EXPECTED_HOSTNAME=

# Optional separate secret for hashing rate-limit identifiers (32+ random characters).
# If blank, the server derives its HMAC key from the Supabase server-only secret.
RATE_LIMIT_SECRET=
