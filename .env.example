# Supabase — Project Settings → Data API / API keys
# (Dashboard → Project Settings → API)
#
# Copy this file to `.env.local` for local dev, and set the same two values in
# Vercel (Project → Settings → Environment Variables) for production.
#
# The service-role key is SECRET and server-only. Never expose it to the browser
# and never commit `.env.local`.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
