# Supabase — Project Settings → Data API / API keys
# (Dashboard → Project Settings → API)
#
# Copy this file to `.env.local` for local dev, and set the same two values in
# Vercel (Project → Settings → Environment Variables) for production.
#
# The service-role key is SECRET and server-only. Never expose it to the browser
# and never commit `.env.local`.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY

# --- Optional: email-on-signup notifications (Resend, free) ---
# Leave these unset to disable email notifications entirely.
# RESEND_API_KEY  — from resend.com → API Keys
# NOTIFY_EMAIL    — where alerts are sent (in Resend's free/test mode this must be
#                   the email you signed up to Resend with)
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- Optional: bot protection (Cloudflare Turnstile, free) ---
# Leave unset to disable the CAPTCHA (the honeypot still runs).
# Both keys come from Cloudflare dashboard → Turnstile → add a site.
# NEXT_PUBLIC_ is exposed to the browser (that's expected for the site key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
